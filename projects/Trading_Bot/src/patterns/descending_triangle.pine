//@version=5
import "../enums/pattern_types.pine" as pt
import "../enums/detection_status.pine" as ds
import "../types/pattern_info.pine" as pi
import "../utils/pivot_points.pine" as pp
import "../utils/calculations.pine" as calc

// Function to detect Descending Triangle pattern
pi.PatternInfo detectDescendingTriangle() =>
    var pi.PatternInfo dt = pi.PatternInfo.new(pt.PatternType.NONE, ds.DetectionStatus.NOT_DETECTED, na, na, na)
    
    // Define the lookback period
    lookback = 30
    
    // Identify pivot highs and lower pivot lows
    pivotHigh1 = pp.findPivotHigh(5, 5)
    pivotHigh2 = pp.findPivotHigh(5, 5)
    pivotLow1 = pp.findPivotLow(5, 5)
    pivotLow2 = pp.findPivotLow(5, 5)
    
    // Ensure that pivot highs and lows are found
    if (not na(pivotHigh1) and not na(pivotHigh2) and not na(pivotLow1) and not na(pivotLow2))
        // Check if pivot highs are forming lower highs
        if (high[pivotHigh2] < high[pivotHigh1])
            // Check if pivot lows are forming approximately equal lows
            if (calc.percentDifference(low[pivotLow1], low[pivotLow2]) < 1.0)
                // Check for breakout
                if (close < ta.lowest(low, pivotLow1, pivotLow2))
                    dt := pi.PatternInfo.new(
                        pt.PatternType.DESCENDING_TRIANGLE,
                        ds.DetectionStatus.DETECTED,
                        pivotLow1,
                        pivotLow2,
                        ta.lowest(low, pivotLow1, pivotLow2)
                    )
    
    dt
