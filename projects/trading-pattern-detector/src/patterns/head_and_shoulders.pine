//@version=5
import "../enums/pattern_types.pine" as pt
import "../enums/detection_status.pine" as ds
import "../types/pattern_info.pine" as pi
import "../utils/pivot_points.pine" as pp
import "../utils/calculations.pine" as calc

// Function to detect Head and Shoulders pattern
pi.PatternInfo detectHeadAndShoulders() =>
    var pi.PatternInfo hs = pi.PatternInfo.new(pt.PatternType.NONE, ds.DetectionStatus.NOT_DETECTED, na, na, na)
    
    // Define the lookback period
    lookback = 50
    
    // Identify three pivot highs: left shoulder, head, right shoulder
    pivotHigh1 = pp.findPivotHigh(5, 5)
    pivotHigh2 = pp.findPivotHigh(5, 5)
    pivotHigh3 = pp.findPivotHigh(5, 5)
    
    // Identify the neckline pivot lows between the shoulders and head
    neckline1 = pp.findPivotLow(5, 5)
    neckline2 = pp.findPivotLow(5, 5)
    
    if (not na(pivotHigh1) and not na(pivotHigh2) and not na(pivotHigh3) and not na(neckline1) and not na(neckline2))
        // Check if head is higher than shoulders
        if (high[pivotHigh2] > high[pivotHigh1] and high[pivotHigh2] > high[pivotHigh3])
            // Check if shoulders are approximately equal within 1%
            if (calc.percentDifference(high[pivotHigh1], high[pivotHigh3]) < 1.0)
                // Check if neckline is approximately equal
                if (calc.percentDifference(low[neckline1], low[neckline2]) < 1.0)
                    // Check for breakout below the neckline
                    if (close < low[neckline2])
                        hs := pi.PatternInfo.new(
                            pt.PatternType.BEARISH_HEAD_AND_SHOULDERS,
                            ds.DetectionStatus.DETECTED,
                            pivotHigh1,
                            pivotHigh3,
                            low[neckline2]
                        )
    
    hs
