//@version=5
import "../enums/pattern_types.pine" as pt
import "../enums/detection_status.pine" as ds
import "../types/pattern_info.pine" as pi
import "../utils/pivot_points.pine" as pp
import "../utils/calculations.pine" as calc

// Function to detect Ascending Triangle pattern
pi.PatternInfo detectAscendingTriangle() =>
    var pi.PatternInfo at = pi.PatternInfo.new(pt.PatternType.NONE, ds.DetectionStatus.NOT_DETECTED, na, na, na)
    
    // Define the lookback period
    lookback = 30
    
    // Identify pivot highs and higher pivot lows
    pivotHigh1 = pp.findPivotHigh(5, 5)
    pivotHigh2 = pp.findPivotHigh(5, 5)
    pivotLow1 = pp.findPivotLow(5, 5)
    pivotLow2 = pp.findPivotLow(5, 5)
    
    // Ensure that pivot highs and lows are found
    if (not na(pivotHigh1) and not na(pivotHigh2) and not na(pivotLow1) and not na(pivotLow2))
        // Check if pivot highs are approximately equal
        if (calc.percentDifference(high[pivotHigh1], high[pivotHigh2]) < 1.0)
            // Check if pivot lows are forming higher lows
            if (low[pivotLow2] > low[pivotLow1])
                // Check for breakout
                if (close > high[pivotHigh2])
                    at := pi.PatternInfo.new(
                        pt.PatternType.ASCENDING_TRIANGLE,
                        ds.DetectionStatus.DETECTED,
                        pivotHigh1,
                        pivotHigh2,
                        high[pivotHigh2]
                    )
    
    at
