//@version=5
import "../enums/pattern_types.pine" as pt
import "../enums/detection_status.pine" as ds
import "../types/pattern_info.pine" as pi
import "../utils/pivot_points.pine" as pp
import "../utils/calculations.pine" as calc

// Function to detect Bullish ABCD pattern
pi.PatternInfo detectBullishABCD() =>
    var pi.PatternInfo abcd = pi.PatternInfo.new(pt.PatternType.NONE, ds.DetectionStatus.NOT_DETECTED, na, na, na)
    
    // Define the lookback period
    lookback = 50
    
    // Identify points A, B, C, D
    // This is a simplified detection method
    pivotA = pp.findPivotLow(5, 5)
    pivotB = pp.findPivotHigh(5, 5)
    pivotC = pp.findPivotLow(5, 5)
    pivotD = pp.findPivotHigh(5, 5)
    
    if (not na(pivotA) and not na(pivotB) and not na(pivotC) and not na(pivotD))
        // Check AB ≈ CD within 1%
        ab = high[pivotB] - low[pivotA]
        cd = high[pivotD] - low[pivotC]
        if (calc.percentDifference(ab, cd) < 1.0)
            // Check BC retracement (e.g., 61.8% retracement)
            bc = high[pivotB] - low[pivotC]
            retracePercent = (high[pivotB] - low[pivotC]) / (high[pivotB] - low[pivotA]) * 100
            if (retracePercent >= 50 and retracePercent <= 65)
                // Check for breakout above point D
                if (close > high[pivotD])
                    abcd := pi.PatternInfo.new(
                        pt.PatternType.BULLISH_ABCD,
                        ds.DetectionStatus.DETECTED,
                        pivotA,
                        pivotD,
                        high[pivotD]
                    )
    
    abcd
