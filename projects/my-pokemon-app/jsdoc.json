{
    "source": {
      "include": ["src"], 
      "exclude": ["node_modules"],  
      "includePattern": ".+\\.js(doc|x)?$",  
      "excludePattern": "(^|\\/|\\\\)_"
    },
    "opts": {
      "encoding": "utf8",
      "destination": "docs/",  
      "recurse": true,
      "verbose": true
    },
    "plugins": [
      "plugins/markdown"  
    ],
    "templates": {
      "cleverLinks": false,
      "monospaceLinks": false
    }
  }
  